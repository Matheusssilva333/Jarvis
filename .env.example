# ==============================================================================
# JARVIS / SENTINELA - CONFIGURAÇÃO DO AMBIENTE
# ==============================================================================

# Caminho absoluto para o cofre do Obsidian
# Por padrão, se vazio, aponta para o diretório pai (raiz do cofre)
OBSIDIAN_VAULT_PATH=..

# Provedor de LLM padrão: gemini | claude | openai | ollama
DEFAULT_LLM_PROVIDER=gemini

# Chaves de API (somente necessárias para o provedor selecionado)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Configurações do Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct

# Configurações de Embeddings e RAG
EMBEDDING_PROVIDER=local_cpu
EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_SEARCH_RESULTS=5
SIMILARITY_THRESHOLD=0.65

# Nível de Segurança: 1 (Read-Only) | 2 (Controlled Write) | 3 (Execution) | 4 (Full Automation)
SECURITY_LEVEL=2

# Gamificação SAO System
SAO_SYSTEM_ENABLED=true
XP_PER_TASK=10
